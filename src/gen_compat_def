#!/bin/bash -efu
# SPDX-License-Identifier: GPL-2.0-only

fatal() {
	echo "Error: $*" >&2
	exit 1
}

eval "$(grep '^KDIR *=' Makefile | tr -d ' ')"
[ "$KDIR" ] || fatal "KDIR is not found"

workdir=cc-test-build
mkdir -p "$workdir"
cd "$workdir" || fatal "cannot enter $workdir"

kbuild_test_compile_optional() {
	local command

	cat > test.c
	echo 'obj-m = test.o' > Makefile
	command="make -s -C $KDIR M=$PWD modules"
	echo "$command" > log
	if $command >> log 2>&1; then
		[ "$2" ] && echo "// $2 is available ${3:+with <$3>}"
		echo "#define HAVE_$1"
		echo
	else
		echo "// ${2:-feature} is unavailable${3:+ with <$3>}. Compile:"
		sed 's/^/\/\/   /' test.c
		echo "// Output:"
		sed 's/^/\/\/   /' log
		echo
	fi
}

echo "// Autogenerated for $KDIR"
echo

kbuild_test_compile_optional X4B_HPFW_PROVIDER \
	"X4B HPFW banset provider API" linux/x4b_hpfw.h <<-EOF
	#include <linux/module.h>
	#include <linux/x4b_hpfw.h>
	#include <linux/x4b_rx_hook.h>
	MODULE_LICENSE("GPL");

	static const struct x4b_hpfw_banset_provider test_provider = {
		.abi_version = X4B_HPFW_PROVIDER_ABI_V1,
		.struct_size = sizeof(struct x4b_hpfw_banset_provider),
	};

	static int __init test_init(void)
	{
		return test_provider.abi_version == X4B_HPFW_PROVIDER_ABI_V1 &&
		       X4B_RX_HOOK_MAX_BATCH > 0 ? 0 : -EINVAL;
	}
	module_init(test_init);
	EOF

echo "// End of compat_def.h"

cd "$OLDPWD"
rm -rf "$workdir"
